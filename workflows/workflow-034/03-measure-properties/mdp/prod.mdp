; Production NPT — converge density and collect energy statistics
integrator    = md
nsteps        = PROD_NSTEPS
dt            = 0.001       ; 1 fs

nstxout-compressed = 2000
nstlog        = 1000
nstenergy     = 100         ; every 0.1 ps — needed for Cv fluctuations

continuation  = yes
constraints   = none
cutoff-scheme = Verlet
ns_type       = grid
nstlist       = 10
; see 02-equilibrate/mdp/melt.mdp — 0.9 nm (was 1.2 nm), the box the
; compressibility fix produces is otherwise too small for a 1.2 nm cutoff.
rcoulomb      = 0.9
rvdw          = 0.9
coulombtype   = PME
pme_order     = 4
fourierspacing = 0.16

tcoupl        = V-rescale
tc-grps       = System
tau_t         = 0.1
ref_t         = TARGET_TEMP

pcoupl        = Berendsen
pcoupltype    = isotropic
tau_p         = 0.5
ref_p         = 1.0
; see 02-equilibrate/mdp/melt.mdp — 2.0e-6 bar^-1 (polymer-melt order of
; magnitude) instead of water's 4.5e-5 (workflow-032 #196/#198 diagnosis).
compressibility = 2.0e-6

pbc           = xyz
gen_vel       = no
