; NPT equilibration at target temperature — density convergence
integrator    = md
nsteps        = EQUIL_NSTEPS
dt            = 0.001       ; 1 fs

nstxout-compressed = 500
nstlog        = 500
nstenergy     = 500

continuation  = yes
constraints   = none
cutoff-scheme = Verlet
ns_type       = grid
nstlist       = 10
rcoulomb      = 1.2
rvdw          = 1.2
coulombtype   = PME
pme_order     = 4
fourierspacing = 0.16

tcoupl        = V-rescale
tc-grps       = System
tau_t         = 0.1
ref_t         = TARGET_TEMP

pcoupl        = Parrinello-Rahman   ; accurate pressure for production-quality density
pcoupltype    = isotropic
tau_p         = 2.0
ref_p         = 1.0
compressibility = 4.5e-5

pbc           = xyz
gen_vel       = no
