; NPT at melt temperature — randomise chain conformations, compress to ~full density
integrator    = md
nsteps        = MELT_NSTEPS
dt            = 0.001       ; 1 fs

nstxout-compressed = 500
nstlog        = 500
nstenergy     = 500

constraints   = none
cutoff-scheme = Verlet
ns_type       = grid
nstlist       = 10
; Was 1.2 nm — with the compressibility fix above actually condensing the box
; (unlike before), the default-length equilibrated box shrinks to ~2.1 nm,
; below the 2.4 nm minimum a 1.2 nm cutoff requires. 0.9 nm (workflow-031's
; convention, proven safe there) keeps headroom for the default box size.
rcoulomb      = 0.9
rvdw          = 0.9
coulombtype   = PME
pme_order     = 4
fourierspacing = 0.16

tcoupl        = V-rescale
tc-grps       = System
tau_t         = 0.1
ref_t         = MELT_TEMP

pcoupl        = Berendsen        ; fast pressure coupling for initial compression
pcoupltype    = isotropic
tau_p         = 0.5
ref_p         = 1.0
; 4.5e-5 bar^-1 (water's compressibility) let the box drift/expand instead of
; condensing toward target density (see workflow-032 #196/#198 diagnosis).
; 2.0e-6 bar^-1 (polymer-melt order of magnitude) fixes it.
compressibility = 2.0e-6

pbc           = xyz
gen_vel       = yes
gen_temp      = MELT_TEMP
gen_seed      = -1
