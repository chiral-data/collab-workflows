; NPT equilibration at target temperature — Berendsen for stability after melt quench
integrator    = md
nsteps        = EQUIL_NSTEPS
dt            = 0.001       ; 1 fs

nstxout-compressed = 500
nstlog        = 500
nstenergy     = 500

continuation  = yes
constraints   = none
cutoff-scheme = Verlet
ns_type       = grid
nstlist       = 10
rcoulomb      = 0.9
rvdw          = 0.9
coulombtype   = PME
pme_order     = 4
fourierspacing = 0.16

tcoupl        = V-rescale
tc-grps       = System
tau_t         = 0.1
ref_t         = TARGET_TEMP

pcoupl        = Berendsen
pcoupltype    = isotropic
tau_p         = 0.5
ref_p         = 1.0
; see mdp/melt.mdp — 2.0e-6 bar^-1 (polymer-melt order of magnitude) instead
; of water's 4.5e-5 (workflow-032 #196/#198 diagnosis).
compressibility = 2.0e-6

pbc           = xyz
gen_vel       = no
